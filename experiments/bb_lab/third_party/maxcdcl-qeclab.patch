+// qec-lab fork: load the -fiber-lb certificate file. Format:
+//   p fiberlb <k> <npairs> <invFloor>
+//   a <k 1-based DIMACS a-var ids>            (class bit j = j-th id)
+//   f <2^k ints>                              (fiberFloorB, index = class)
+//   <npairs lines: "x y" 1-based DIMACS pairs>
+void Solver::fiberLoad(const char* path) {
+  FILE* f = fopen(path, "r");
+  if (f == NULL) {
+    printf("c WARNING! cannot open fiber-lb file %s\n", path); return;
+  }
+  int k, npairs; long invF;
+  if (fscanf(f, "p fiberlb %d %d %ld", &k, &npairs, &invF) != 3
+      || k < 0 || k > 20 || npairs < 1) {
+    printf("c WARNING! bad fiber-lb header\n"); fclose(f); return;
+  }
+  char tag[8];
+  if (fscanf(f, "%4s", tag) != 1 || tag[0] != 'a') {
+    printf("c WARNING! bad fiber-lb a-line\n"); fclose(f); return;
+  }
+  fiberK = k; fiberInvFloor = (int)invF;
+  fiberAVars.clear(); fiberFloorB.clear();
+  fiberPairX.clear(); fiberPairY.clear();
+  for (int j = 0; j < k; j++) {
+    int id;
+    if (fscanf(f, "%d", &id) != 1 || id <= 0 || id > nVars()) {
+      printf("c WARNING! bad fiber-lb a-var\n"); fclose(f); return;
+    }
+    fiberAVars.push(id - 1);
+  }
+  if (fscanf(f, "%4s", tag) != 1 || tag[0] != 'f') {
+    printf("c WARNING! bad fiber-lb f-line\n"); fclose(f); return;
+  }
+  for (int c = 0; c < (1 << k); c++) {
+    int v;
+    if (fscanf(f, "%d", &v) != 1) {
+      printf("c WARNING! bad fiber-lb table\n"); fclose(f); return;
+    }
+    fiberFloorB.push(v);
+  }
+  // Optional v2 "g" table: per-class floors on the moving completion
+  // cost itself (seam/window-scale). Absent in v1 files.
+  fiberCostB.clear();
+  {
+    long pos = ftell(f);
+    char t2[8];
+    if (fscanf(f, "%4s", t2) == 1 && t2[0] == 'g') {
+      for (int c = 0; c < (1 << k); c++) {
+        int v;
+        if (fscanf(f, "%d", &v) != 1) {
+          printf("c WARNING! bad fiber-lb g-table\n"); fclose(f); return;
+        }
+        fiberCostB.push(v);
+      }
+    } else {
+      fseek(f, pos, SEEK_SET);
+    }
+  }
+  for (int i = 0; i < npairs; i++) {
+    int x, y;
+    if (fscanf(f, "%d %d", &x, &y) != 2
+        || x <= 0 || y <= 0 || x > nVars() || y > nVars()) {
+      printf("c WARNING! bad fiber-lb pair\n"); fclose(f); return;
+    }
+    fiberPairX.push(x - 1); fiberPairY.push(y - 1);
+  }
+  fclose(f);
+  fiberEnabled = 1; fbValid = 0;
+  printf("c fiber-lb: k=%d pairs=%d invFloor=%d costTable=%d\n",
+         k, npairs, fiberInvFloor, fiberCostB.size() > 0);
+}
+
+// qec-lab fork: the fiber/pushforward node bound. Every completion is
+// either invariant (all fibers even; cost >= max(fiberInvFloor,
+// trues + cost of closing half-open-true fibers even)) or moving
+// (#odd fibers >= fiberFloorB[class], each odd fiber holding >= one
+// true). If min over the two branches reaches UB, no completion can
+// improve the incumbent: fire a soft conflict through the
+// UBconflictFlag premise hook, supplying every assigned literal the
+// arithmetic consumed (falseLits already carries the assigned trues).
+bool Solver::fiberSoftConflict() {
+  if (!fiberEnabled || UB == 0) return false;
+  int64_t t = falseLits.size();
+  if (t >= (int64_t)UB) return false;      // stock check handles it
+  int odd_now = 0, oddable0 = 0, oddable1 = 0;
+  for (int i = 0; i < fiberPairX.size(); i++) {
+    lbool vx = value(fiberPairX[i]), vy = value(fiberPairY[i]);
+    if (vx == l_Undef && vy == l_Undef) oddable1++;
+    else if (vx == l_Undef || vy == l_Undef) {
+      if ((vx == l_Undef ? vy : vx) == l_True) oddable0++;
+      else oddable1++;
+    }
+    else if (vx != vy) odd_now++;
+  }
+  uint32_t mask = 0, vals = 0;
+  for (int j = 0; j < fiberK; j++) {
+    lbool va = value(fiberAVars[j]);
+    if (va != l_Undef) {
+      mask |= 1u << j;
+      if (va == l_True) vals |= 1u << j;
+    }
+  }
+  int Fb, Gb;
+  if (fbValid && mask == fbLastMask && vals == fbLastVals) {
+    Fb = fbLastF; Gb = fbLastG;
+  }
+  else {
+    Fb = INT32_MAX; Gb = INT32_MAX;
+    bool haveG = fiberCostB.size() > 0;
+    for (int c = 1; c < (1 << fiberK); c++)
+      if ((((uint32_t)c) & mask) == vals) {
+        if (fiberFloorB[c] < Fb) Fb = fiberFloorB[c];
+        if (haveG && fiberCostB[c] < Gb) Gb = fiberCostB[c];
+      }
+    if (!haveG) Gb = 0;
+    fbLastMask = mask; fbLastVals = vals;
+    fbLastF = Fb; fbLastG = Gb; fbValid = 1;
+  }
+  // Moving bound: odd-fiber arithmetic from the F table, plus the
+  // direct certified completion-cost floor from the optional G table
+  // (every moving completion in a consistent class costs >= Gb).
+  int64_t mLB;
+  if (Fb == INT32_MAX) mLB = INT64_MAX;    // no consistent class
+  else {
+    int needOdd = Fb - odd_now;
+    if (odd_now == 0 && needOdd < 1) needOdd = 1;
+    if (needOdd < 0) needOdd = 0;
+    if (needOdd > oddable0 + oddable1) mLB = INT64_MAX;
+    else {
+      int extra = needOdd - oddable0;
+      if (extra < 0) extra = 0;
+      mLB = t + extra;
+      if ((int64_t)Gb > mLB) mLB = Gb;
+    }
+  }
+  int64_t nodeLB;
+  if (odd_now > 0) nodeLB = mLB;
+  else {
+    int64_t iLB = t + oddable0;
+    if ((int64_t)fiberInvFloor > iLB) iLB = fiberInvFloor;
+    nodeLB = (mLB < iLB) ? mLB : iLB;
+  }
+  if (nodeLB < (int64_t)UB) return false;
+  // Premises: assigned-false fiber vars and assigned a-vars, as their
+  // currently-false literals (assigned-true fiber vars are softs and
+  // already sit in falseLits). Root-level (level 0) assignments are
+  // globally valid and omitted, matching the analyzer's convention.
+  for (int i = 0; i < fiberPairX.size(); i++) {
+    for (int s = 0; s < 2; s++) {
+      Var v = s ? fiberPairY[i] : fiberPairX[i];
+      if (value(v) == l_False && level(v) > 0 && !involved[v]) {
+        involved[v] = 1;
+        involvedLits.push(mkLit(v, false));
+      }
+    }
+  }
+  for (int j = 0; j < fiberK; j++) {
+    Var v = fiberAVars[j];
+    if (value(v) != l_Undef && level(v) > 0 && !involved[v]) {
+      involved[v] = 1;
+      involvedLits.push(value(v) == l_True ? mkLit(v, true)
+                                           : mkLit(v, false));
+    }
+  }
+  fiberConfls++;
+  UBconflictFlag = true; softConflictFlag = true;
+  return true;
+}
 
